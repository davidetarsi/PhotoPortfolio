    "staging": {
      "name": "photo-portfolio-staging",
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "photo-portfolio-staging" }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": "",
        "R2_PUBLIC_URL": "https://5bb4fb0e1b0c25a5fee6b56ee22742ba.r2.cloudflarestorage.com/photo-portfolio-staging"
      }
    }
  }
}
