{
  "name": "photo-portfolio",
  "compatibility_date": "2026-07-07",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "<INSERISCI_QUI_IL_NOME_DEL_TUO_BUCKET_R2>" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },
  "env": {
    "staging": {
      "name": "photo-portfolio-staging",
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "<INSERISCI_QUI_IL_NOME_DEL_TUO_BUCKET_R2>-staging" }
      ],
      "vars": {
        "ACCESS_TEAM_DOMAIN": "",
        "ACCESS_AUD": ""
      }
    }
  }
}
