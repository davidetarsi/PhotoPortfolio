{
  "name": "photo-portfolio",
  "compatibility_date": "2026-07-07",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "replace-with-real-production-bucket-name" }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "R2_PUBLIC_URL": ""
  },
